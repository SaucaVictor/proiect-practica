# NeuralChat — Environment Variables
# Copy this file to .env and fill in your credentials

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── NVIDIA NIM ──────────────────────────────────────────────────────────────
# NVIDIA Developer Key to call NVIDIA NIM inference endpoints
VITE_NVIDIA_API_KEY=nvapi-your-key-here

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=NeuralChat
VITE_APP_URL=http://localhost:5173

# ─── Speech-to-Text (ASR) ───────────────────────────────────────────────────
# Option A: Hugging Face Serverless Inference API Token (100% Free)
# Get a token at: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=hf_your-token-here

# Option B: Local ASR Endpoint (routed via public localtunnel)
VITE_ASR_ENDPOINT=https://classmonitor-audio-e7a9b2f.loca.lt/transcribe

# ─── Deepgram ────────────────────────────────────────────────────────────────
# Deepgram API Key for real-time and batch speech-to-text transcription
DEEPGRAM=your-deepgram-api-key-here

# ─── Jira Integration ───────────────────────────────────────────────────────
# Jira API credentials for automations and logging work sessions
JIRA_EMAIL=your-email@gmail.com
JIRA_API_TOKEN=your-jira-api-token
